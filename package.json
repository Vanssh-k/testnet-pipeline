{
  "name": "lighthouse-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "node --loader=ts-node/esm src/index.ts",
    "build": "npx tsc",
    "start": "node ./dist/src/index.js",
    "start:prod": "npm run build && node ./dist/src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.+(js|ts|json)\"",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*": [
      "prettier  --write \"**/*.+(js|ts|json)\""
    ],
    "**/*.ts": "eslint . --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.549.0",
    "@aws-sdk/lib-dynamodb": "^3.549.0",
    "@cosmjs/amino": "^0.32.3",
    "@cosmjs/crypto": "^0.32.3",
    "@cosmjs/encoding": "^0.32.3",
    "@radixdlt/rola": "^2.1.0",
    "@solana/web3.js": "^1.91.4",
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "express-winston": "^4.2.0",
    "ioredis": "^5.4.1",
    "is-ipfs": "^8.0.4",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multiformats": "^13.1.3",
    "neverthrow": "^8.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "prom-client": "^15.1.1",
    "redis": "^4.6.13",
    "secp256k1": "^5.0.0",
    "stripe": "^14.24.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-loki": "^6.0.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/secp256k1": "^4.0.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.4"
  }
}
