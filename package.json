{
    "name": "lighthouse-backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon ./src/index.ts",
        "start": "node ./dist/index.js",
        "start-prod": "npx tsc && node ./dist/index.js",
        "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
        "prepare": "npx tsc && node ./dist/index.js && husky install",
        "build": "npx tsc",
        "lint": "eslint . --ext .ts",
        "lint-basic": "tslint -p tsconfig.json",
        "test": "jest --detectOpenHandles --forceExit"
    },
    "husky": {
        "hooks": {
            "pre-push": "lint-staged"
        }
    },
    "lint-staged": {
        "src/**/*.{js, ts, json, css, md, html)":  "prettier --single-quote --write"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
