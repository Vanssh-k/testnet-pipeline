{
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es5","es6","es7"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,  
    "module": "commonjs",
    "target": "es6",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowJs": true,
    "noImplicitAny": true,
  },
  "include": ["src","src/**/*.ts",],
  "exclude": ["node_modules", "**/*.spec.ts","**/*.test.ts",".vscode","dist"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
  
}
